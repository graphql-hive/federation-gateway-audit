{
  "compilerOptions": {
    "outDir": "./dist",
    "strict": true,
    "target": "ESNext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "allowSyntheticDefaultImports": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true
  },
  "include": ["src"]
}
